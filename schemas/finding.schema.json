    "finding_type",
    "severity",
    "evidence_ids"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "finding_type": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array"
    },
    "description": {
      "type": "string"
    }
  }
}