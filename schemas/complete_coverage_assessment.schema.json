    "scenario_coverage_claim": {"enum": ["not_covered", "partially_covered", "operationally_covered", "comprehensively_covered"]},
    "complete_coverage_gate_passed": {"type": "boolean"},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
